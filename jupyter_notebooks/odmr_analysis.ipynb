    "def parse_thickness(thickness_str):\n",
    "    thickness_str = thickness_str.strip()\n",
    "    if thickness_str.lower() == \"flake directly on waveguide\":\n",
    "        return None  # baseline run, no intrinsic thickness\n",
    "    return float(thickness_str.split()[0])  # \"130 nm\" -> 130.0\n",
    "\n",
    "for run in runs.values():\n",
    "    run[\"thickness_nm\"] = parse_thickness(run[\"thickness\"])\n",
    "\n",
    "def get_run_contrast(run, freq_range=None, n_peaks=4):\n",
    "    centers = find_dip_centers(run, n_peaks=n_peaks, freq_range=freq_range)\n",
    "    result = fit_run(run, centers)\n",
    "    contrast, depths, dip_centers = compute_contrast(result, run[\"frequencies\"], n_peaks=n_peaks)\n",
    "    return contrast\n",
    "\n",
    "def plot_contrast_vs_thickness_by_device(runs, keys, freq_ranges=None):\n",
    "    freq_ranges = freq_ranges or {}\n",
    "    devices = sorted(set(runs[k][\"device\"] for k in keys))\n",
    "\n",
    "    fig, axes = plt.subplots(1, len(devices), figsize=(6 * len(devices), 5))\n",
    "    if len(devices) == 1:\n",
    "        axes = [axes]\n",
    "\n",
    "    for ax, device in zip(axes, devices):\n",
    "        device_keys = [k for k in keys if runs[k][\"device\"] == device]\n",
    "        plot_contrast_vs_thickness(runs, device_keys, ax=ax, freq_ranges=freq_ranges)\n",
    "        ax.set_title(f\"Contrast vs. thickness — {device}\")\n",
    "\n",
    "    plt.tight_layout()\n",
    "    return axes\n",
    "\n",
    "def compute_enhancement_factors(runs, keys, freq_ranges=None):\n",
    "    freq_ranges = freq_ranges or {}\n",
    "\n",
    "    # one baseline contrast per device\n",
    "    baseline_contrast = {}\n",
    "    for key, run in runs.items():\n",
    "        if run[\"thickness_nm\"] is None:\n",
    "            baseline_contrast[run[\"device\"]] = get_run_contrast(run, freq_range=freq_ranges.get(key))\n",
    "\n",
    "    thicknesses, enhancements, devices = [], [], []\n",
    "    for key in keys:\n",
    "        run = runs[key]\n",
    "        if run[\"thickness_nm\"] is None:\n",
    "            continue  # skip baseline runs, per your spec\n",
    "        contrast = get_run_contrast(run, freq_range=freq_ranges.get(key))\n",
    "        enhancements.append(contrast / baseline_contrast[run[\"device\"]])\n",
    "        thicknesses.append(run[\"thickness_nm\"])\n",
    "        devices.append(run[\"device\"])\n",
    "\n",
    "    return thicknesses, enhancements, devices\n",
    "\n",
    "\n",
    "def plot_enhancement_vs_thickness(runs, keys, ax=None, freq_ranges=None):\n",
    "    if ax is None:\n",
    "        fig, ax = plt.subplots(figsize=(7, 5))\n",
    "\n",
    "    thicknesses, enhancements, devices = compute_enhancement_factors(runs, keys, freq_ranges)\n",
    "\n",
    "    colors = {\"Montana\": \"#1f77b4\", \"Albania\": \"#ff7f0e\"}\n",
    "    for device in set(devices):\n",
    "        x = [t for t, d in zip(thicknesses, devices) if d == device]\n",
    "        y = [e for e, d in zip(enhancements, devices) if d == device]\n",
    "        ax.scatter(x, y, label=device, s=80, color=colors.get(device),\n",
    "                   edgecolor=\"black\", linewidth=0.8, zorder=3)\n",
    "\n",
    "    ax.axhline(1, color=\"gray\", linestyle=\"--\", linewidth=1, alpha=0.7, zorder=1,\n",
    "               label=\"no enhancement\")\n",
    "\n",
    "    ax.set_xlabel(\"Intrinsic thickness (nm)\")\n",
    "    ax.set_ylabel(\"Enhancement factor\")\n",
    "    ax.set_title(\"Enhancement factor vs. thickness\", fontsize=13, fontweight=\"bold\")\n",
    "    ax.grid(True, alpha=0.3, zorder=0)\n",
    "    ax.legend(frameon=False)\n",
    "    ax.spines[\"top\"].set_visible(False)\n",
    "    ax.spines[\"right\"].set_visible(False)\n",
    "\n",
    "    return ax"
   ]
